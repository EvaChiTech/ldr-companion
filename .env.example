# ============================================================
# LDR Companion — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# The OpenAI API key is NOT a client variable. Never prefix it with VITE_
# (that bundles it into the public JS shipped to every browser). Set it as a
# Supabase Edge Function secret instead:
#   supabase secrets set OPENAI_API_KEY=sk-your-openai-key-here
#
# Default model is gpt-4o-mini. Long-form narrative functions
# (memory-chapter, anniversary-surprise, yearly-wrapped) opt into gpt-4o.

# CORS allowlist for edge functions. Without this set, the guard rejects
# all browser origins (fail closed). Comma-separated.
#   supabase secrets set ALLOWED_ORIGINS="https://your-app.vercel.app"
